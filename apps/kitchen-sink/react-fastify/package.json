{
  "name": "kitchen-sink-react-fastify",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The kitchen sink with React on Fastify",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "vite build",
    "start:prod": "NODE_ENV=production tsx src/main.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@inertiajs/react": "^3.7.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "kitchen-sink": "workspace:*",
    "nestjs-mvc": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.2.2"
  }
}
