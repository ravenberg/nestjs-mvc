    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
