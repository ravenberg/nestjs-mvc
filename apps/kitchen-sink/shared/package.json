{
  "name": "kitchen-sink",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The shared kitchen sink: server code, platform bootstraps, React and Vue pages and e2e specs for every kitchen-sink-<framework>-<platform> app",
  "exports": {
    "./server": "./server/index.ts",
    "./platform/express": "./platform/express/index.ts",
    "./platform/fastify": "./platform/fastify/index.ts",
    "./e2e/config": "./e2e/config.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && vue-tsc -p tsconfig.vue.json --noEmit"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@inertiajs/react": "^3.7.0",
    "@inertiajs/vue3": "^3.7.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^12.0.1",
    "better-sqlite3": "^12.11.1",
    "lucide-react": "^1.42.0",
    "lucide-vue-next": "^1.0.0",
    "nestjs-mvc": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1",
    "vue": "^3.5.42",
    "zod": "^4.5.4"
  },
