{
  "name": "nestjs-inertia-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for @nestjs-inertia — a modern Inertia.js adapter for NestJS",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "pnpm -r --filter './packages/*' test",
    "dev": "pnpm --filter demo dev",
    "lint": "oxlint packages/core/src apps/demo/src apps/demo/frontend"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "oxlint": "^1.79.0"
  }
}
