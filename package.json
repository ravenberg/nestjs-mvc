{
  "name": "nestjs-mvc-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for nestjs-mvc — a modern Inertia.js adapter for NestJS",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "pnpm -r --filter './packages/*' test",
    "dev": "pnpm --filter demo dev",
    "lint": "oxlint packages/core/src apps/demo/src apps/demo/frontend"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3"
    ]
  },
  "devDependencies": {
    "oxlint": "^1.79.0"
  }
}
